{
  "name": "slidelot",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^18.0.10",
      "zod": "^4.6.7",
      "typescript": "^7.0.2",
      "@types/bun": "^1.4.4",
      "hono": "^4.13.17",
      "@trpc/server": "^11.24.0",
      "@libsql/client": "0.18.0",
      "libsql": "0.5.29",
      "@trpc/client": "^11.24.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @slidelot/db db:push",
    "db:studio": "turbo -F @slidelot/db db:studio",
    "db:generate": "turbo -F @slidelot/db db:generate",
    "db:migrate": "turbo -F @slidelot/db db:migrate",
    "db:local": "turbo -F @slidelot/db db:local"
  },
  "dependencies": {
    "@slidelot/env": "workspace:*",
    "cledon": "^0.2.0",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@slidelot/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "minimatch": "11.0.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
